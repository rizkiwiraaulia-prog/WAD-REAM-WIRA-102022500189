<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profil Penjaga Kos X</title>
  <link rel="stylesheet" href="style.css">
  <!-- Font Google untuk gaya typography bold -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800;900&family=Inter:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Background dengan Pola Kotak/Grid dan Chequerboard -->
  <div class="page-container">
    
    <!-- Judul Atas Kiri -->
    <h1 class="main-title">PERSONAL RESUME</h1>

    <!-- Kartu Utama -->
    <div class="card-container">
      
      <!-- Hiasan Bulat Kanan Atas Kartu -->
      <div class="card-dots">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>

      <!-- Konten Utama Kartu -->
      <div class="card-content">
        
        <!-- Kolom Kiri: Foto & Rating -->
        <div class="profile-section">
          <div class="photo-wrapper">
            <img src="https://media.istockphoto.com/id/175440771/photo/handsome-young-man-gesturing-thumbs-up-isolated.jpg?s=612x612&w=0&k=20&c=RMLEXPrDjwFg7uPb_Ri3KqpYF0BAEPjzloAB81viyCk=" alt="Foto Profil" class="profile-img">
          </div>
          <div class="stars">
            ★ ★ ★ ★ ★
          </div>
        </div>

        <!-- Kolom Kanan: Detail Informasi & Skills -->
        <div class="info-section">
          <h2 class="name-title">NAMA: ABC</h2>
          <p class="quote">
            "Termasuk salah satu penjaga yang lumayan muda di sini."
          </p>

          <!-- Label Vertikal + List Skill Bar -->
          <div class="skills-wrapper">
            <div class="skills-label">SKILLS</div>
            <div class="skills-list">
              
              <!-- Skill Bar 1 (Pink) -->
              <div class="skill-item">
                <div class="skill-tag tag-pink">STATUS: AKTIF</div>
                <div class="skill-bar bar-pink">
                  <span class="icon">🧮</span>
                </div>
              </div>

              <!-- Skill Bar 2 (Orange) -->
              <div class="skill-item">
                <div class="skill-tag tag-orange">Umur: 33 tahun</div>
                <div class="skill-bar bar-orange">
                  <span class="icon">⏰</span>
                </div>
              </div>

              <!-- Skill Bar 3 (Hijau) -->
              <div class="skill-item">
                <div class="skill-tag tag-green">Pekerjaan: Penjaga Kos X</div>
                <div class="skill-bar bar-green">
                  <span class="icon">🧪</span>
                </div>
              </div>

              <!-- Skill Bar 4 (Abu-abu) -->
              <div class="skill-item">
                <div class="skill-tag tag-grey">ABCDEFG</div>
                <div class="skill-bar bar-grey">
                  <span class="icon">⚙️</span>
                </div>
              </div>

            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

</body>
</html>